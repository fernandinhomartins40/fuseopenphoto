<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- Product identity: rename the installed product here (and in install-policy.json; the app's
       own name lives in crates/ui-egui/src/studio/style.rs). -->
  <?define ProductName="Fuse Open Photo" ?>
  <?define Company="Fuse" ?>
  <?ifndef HasCodex ?>
  <?define HasCodex=0 ?>
  <?endif?>
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="$(var.ProductName)" Manufacturer="$(var.Company)" Version="$(var.Version)" UpgradeCode="833166CE-AE62-44C1-8F7F-9F9B10E03C8F" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="$(var.ProductName) image editor" Manufacturer="$(var.Company)" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="PhotocraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="PhotocraftIcon.exe" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="$(var.Company)">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by PhotocraftApp). -->

    <Feature Id="Main" Title="$(var.ProductName)" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="PhotocraftFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPhotocraft" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through photocraft.en-us.wxl. -->
    <Property Id="PhotocraftVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="$(var.ProductName) $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch $(var.ProductName)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#PhotocraftExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchPhotocraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="PhotocraftFiles" Directory="INSTALLFOLDER">
      <Component Id="PhotocraftApp" Guid="CD820670-5E55-4EAF-9798-1C569C780C0A">
        <File Id="PhotocraftExe" Source="$(var.BinDir)\photocraft.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="$(var.ProductName)" Description="$(var.ProductName) image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="PhotocraftIcon.exe" IconIndex="0" />
        </File>

        <!-- .pcraft: the app's own format; this app is its default handler. -->
        <ProgId Id="FuseOpenPhoto.Document" Description="$(var.ProductName) Document" Icon="PhotocraftExe" IconIndex="0">
          <Extension Id="pcraft" ContentType="application/x-photocraft">
            <Verb Id="open" Command="Open" TargetFile="PhotocraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="FuseOpenPhoto.PhotoshopDocument" Description="PSD Document" Icon="PhotocraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\FuseOpenPhoto.PhotoshopDocument\shell\open\command" Value="&quot;[#PhotocraftExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="FuseOpenPhoto.Image" Description="Image" Icon="PhotocraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\FuseOpenPhoto.Image\shell\open\command" Value="&quot;[#PhotocraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psd\OpenWithProgids" Name="FuseOpenPhoto.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psb\OpenWithProgids" Name="FuseOpenPhoto.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdn\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ora\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.kra\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.krz\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tif\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tiff\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.webp\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.gif\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.bmp\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tga\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.exr\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.hdr\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.avif\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.qoi\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ico\OpenWithProgids" Name="FuseOpenPhoto.Image" Value="" Type="string" />

        <!-- No App Paths or "Applications" keys: they are keyed by the exe name, which an
             installed PhotoCraft shares, so writing (and uninstalling) them would break that app. -->
        <RegistryValue Root="HKMU" Key="Software\$(var.Company)\$(var.ProductName)" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="PhotocraftCli">
        <File Id="PhotocraftCliExe" Source="$(var.BinDir)\photocraft-cli.exe" KeyPath="yes" />
      </Component>
      <?if $(var.HasCodex) = 1 ?>
      <!-- Window > Codex: the OpenAI Codex CLI (Apache-2.0) and its helpers, staged by package.ps1 -CodexDir. -->
      <Files Include="$(var.BinDir)\codex\*.exe" />
      <?endif?>
    </ComponentGroup>
  </Fragment>
</Wix>
