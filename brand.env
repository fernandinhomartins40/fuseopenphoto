# Product identity: the one place to rename the product. Plain KEY=value lines.
# Read at build time by crates/ui-egui/build.rs (app name, window class, settings folder),
# apps/photocraft/build.rs and apps/photocraft-cli/build.rs (Windows version info) and
# packaging/windows/package.ps1 (MSI name, manufacturer, folders, shortcuts, output file name).
# Changing BRAND_NAME or BRAND_ID also moves the per-user settings folder.
BRAND_NAME=Fuse Open Photo
BRAND_COMPANY=Fuse
BRAND_ID=com.fuse.openphoto
BRAND_FILE=fuse-open-photo
